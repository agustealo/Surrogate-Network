# Local runtime contract only.
# Do not place hosted provider credentials here.
# Start the repository-owned Supabase stack and generate .env.local with:
#   npm run local:up
# or, when Supabase is already running:
#   npm run local:config
#
# .env.local is gitignored and generated from `supabase status -o env`.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MAILPIT_URL=
